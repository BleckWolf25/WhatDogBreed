{
  "name": "whatdogbreed",
  "version": "1.0.0",
  "description": "Discover about the dog infront of you in seconds.",
  "author": "João Costa <joao.coutinho08@gmail.com>",
  "license": "MIT",
  "homepage": "https://whatdogbreed.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BleckWolf25/WhatDogBreed.git"
  },
  "bugs": {
    "url": "https://github.com/BleckWolf25/WhatDogBreed/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "pnpm lint && pnpm typecheck && pnpm format && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-vercel": "^7.0.3",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.5",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@google/generative-ai": "^0.24.1",
    "@lucide/svelte": "^1.73.0",
    "@svelteuidev/composables": "^0.15.7",
    "@svelteuidev/core": "^0.15.7",
    "dayjs": "^1.11.23",
    "idb-keyval": "^6.3.0"
  },
  "packageManager": "pnpm@12.21.0"
}
