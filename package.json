{
  "name": "whatdogbreed",
  "version": "1.0.0",
  "description": "Discover about the dog infront of you in seconds.",
  "author": "João Costa <joao.coutinho08@gmail.com>",
  "license": "MIT",
  "homepage": "https://whatdogbreed.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BleckWolf25/WhatDogBreed.git"
  },
  "bugs": {
    "url": "https://github.com/BleckWolf25/WhatDogBreed/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "pnpm tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "pnpm lint && pnpm typecheck && pnpm format && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.3",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@google/generative-ai": "^0.24.1",
    "@lucide/svelte": "^1.30.0",
    "@svelteuidev/composables": "^0.15.7",
    "@svelteuidev/core": "^0.15.7",
    "@vercel/analytics": "^2.0.1",
    "dayjs": "^1.11.21",
    "idb-keyval": "^6.2.2"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
